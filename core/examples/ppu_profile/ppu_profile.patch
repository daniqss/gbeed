index 4d38b9e..52cef4e 100644
--- a/core/examples/ppu_profile/main.rs
+++ b/core/examples/ppu_profile/main.rs
@@ -28,8 +28,14 @@ impl Renderer for ProfileController {
     fn read_pixel(&self, x: usize, y: usize) -> u32 { self.framebuffer[y][x] }
 
     fn write_pixel(&mut self, x: usize, y: usize, palette: u8, color_id: u8) {
+        self.framebuffer[y][x] = self.get_color(palette, color_id);
+    }
+
+    // the unoptimized drawing loops resolve the sprite to background priority by
+    // reading the framebuffer back, so they need to know the colour of a given index
+    fn get_color(&self, palette: u8, color_id: u8) -> u32 {
         let shade = (palette >> (color_id * 2)) & 0x03;
-        self.framebuffer[y][x] = self.colors[shade as usize];
+        self.colors[shade as usize]
     }
 }
 
