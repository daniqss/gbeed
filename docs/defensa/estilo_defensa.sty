\ifdefined\lingua
  \message{Estilo defensa: elixiuse como lingua da presentacion: \lingua}
\else
  \message{Estilo defensa warning: non se elixiu lingua para a presentacion (fallback: galego)}
  \def\lingua{gal}
\fi
\ifthenelse{\equal{\lingua}{gal}}{%
  \message{Estilo defensa: cargando definicións para galego}
  \setdefaultlanguage{galician}
  \setotherlanguage{english}
  \def\nomeindice{Índice}
  \def\nomedirixe{Dirección}
  \def\nomeestudante{Estudante}
  \def\nometfg{TRABALLO FIN DE GRAO}
}{%
\ifthenelse{\equal{\lingua}{esp}}{%
  \message{Estilo defensa: cargando definicións para español}
  \setdefaultlanguage{spanish}
  \setotherlanguage{english}
  \def\nomeindice{Índice}
  \def\nomedirixe{Dirección}
  \def\nomeestudante{Estudiante}
  \def\nometfg{TRABAJO FIN DE GRADO}
}{%
\ifthenelse{\equal{\lingua}{eng}}{%
  \message{Estilo defensa: cargando definicións para inglés}
  \setdefaultlanguage{english}
  \setotherlanguage{galician}
  \def\nomeindice{Outline}
  \def\nomedirixe{Supervision}
  \def\nomeestudante{Student}
  \def\nometfg{BACHELOR'S DEGREE FINAL PROJECT}
}{%
  \message{Estilo defensa warning: non se detectou correctamente a lingua (fallback: galego)}
}}}


