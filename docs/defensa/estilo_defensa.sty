\definecolor{udcpink}{RGB}{177,0,114}
\definecolor{udcgray}{RGB}{100,100,100}
\definecolor{ficblue}{RGB}{50,110,118}


\usetheme{default}
\usecolortheme{default}
\usefonttheme{professionalfonts}
\setbeamertemplate{navigation symbols}{}

\setbeamercolor{normal text}{fg=black!87}
\setbeamercolor{structure}{fg=ficblue}
\setbeamercolor{title}{fg=ficblue}
\setbeamercolor{subtitle}{fg=udcgray}
\setbeamercolor{author}{fg=black!87}
\setbeamercolor{date}{fg=udcgray}
\setbeamercolor{frametitle}{fg=ficblue,bg=}
\setbeamercolor{framesubtitle}{fg=udcgray}
\setbeamercolor{alerted text}{fg=udcpink}
\setbeamercolor{section in toc}{fg=ficblue}
\setbeamercolor{subsection in toc}{fg=udcgray}
\setbeamercolor{itemize item}{fg=udcpink}
\setbeamercolor{itemize subitem}{fg=ficblue}
\setbeamercolor{itemize subsubitem}{fg=udcgray}
\setbeamercolor{enumerate item}{fg=udcpink}
\setbeamercolor{caption name}{fg=udcpink}
\setbeamercolor{block title}{fg=white,bg=ficblue}
\setbeamercolor{block body}{fg=black!87,bg=ficblue!8}
\setbeamercolor{block title alerted}{fg=white,bg=udcpink}
\setbeamercolor{block body alerted}{fg=black!87,bg=udcpink!8}

\setbeamerfont{title}{series=\bfseries,size=\LARGE}
\setbeamerfont{frametitle}{series=\bfseries,size=\Large}
\setbeamerfont{framesubtitle}{series=\mdseries,size=\small}
\setbeamerfont{caption}{size=\footnotesize}
\setbeamerfont{block title}{series=\bfseries,size=\normalsize}

\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{section in toc}[sections numbered]


\newlength{\beamermargin}
\setlength{\beamermargin}{0.9cm}
\newcommand{\bigrule}{{\color{udcpink}\rule{\dimexpr\paperwidth-2\beamermargin\relax}{0.5mm}}}
\setbeamersize{text margin left=\beamermargin, text margin right=\beamermargin}

\setbeamertemplate{frametitle}{%
  \vspace*{0.55cm}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=\beamermargin,rightskip=\beamermargin]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle\strut\par
    \ifx\insertframesubtitle\@empty\else%
      \vspace{0.1em}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\strut\par}%
    \fi
    \nointerlineskip\vspace{0.3em}\bigrule\par
  \end{beamercolorbox}%
  \vspace*{0.2cm}%
}


\ifdefined\titulocurto\else\def\titulocurto{\titulo}\fi

\setbeamertemplate{footline}{%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth,ht=2.4ex,dp=1.2ex,right,rightskip=\beamermargin]{}%
      {\scriptsize\color{udcpink}\bfseries\insertframenumber}%
    \end{beamercolorbox}%
  }%
  \vspace*{0.1cm}%
}

\AtBeginSection[]{%
  \begin{frame}[plain,noframenumbering]
    \vfill
    \begin{center}
      {\color{ficblue}\Huge\bfseries\thesection.\ \insertsectionhead}\\[0.5em]
      {\color{udcpink}\rule{0.35\paperwidth}{0.5mm}}
    \end{center}
    \vfill
  \end{frame}
}

\newcommand{\imaxe}[3][0.8\textwidth]{%
  \begin{center}
    \includegraphics[width=#1,height=0.62\textheight,keepaspectratio]{#2}\\[0.35em]
    {\footnotesize\color{udcgray}#3}
  \end{center}%
}

\newcommand{\fonte}[1]{{\footnotesize\color{udcgray}#1}}

\newcommand{\destacado}[1]{\textcolor{udcpink}{\bfseries #1}}

\lstset{
  basicstyle=\ttfamily\scriptsize,
  % o marco do listing debe quedar sempre dentro das marxes da diapositiva
  xleftmargin=3.4pt,
  xrightmargin=3.4pt,
  breakatwhitespace=true,
  breaklines=true,
  captionpos=b,
  commentstyle=\color{udcgray},
  frame=single,
  keepspaces=true,
  keywordstyle=\color{ficblue},
  numbers=none,
  numbersep=5pt,
  numberstyle=\tiny\color{udcgray},
  rulecolor=\color{udcgray},
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  stepnumber=1,
  stringstyle=\color{udcpink},
  tabsize=2
}

% listings non trae Nix de serie
\lstdefinelanguage{Nix}{
  morekeywords={let,in,inherit,with,rec,import,if,then,else,assert,or},
  morecomment=[l]{\#},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  sensitive=true,
}

